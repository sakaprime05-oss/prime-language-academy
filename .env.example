# =============================================================
# Prime Language Academy — variables d'environnement
# Copiez ce fichier en `.env` puis complétez les valeurs.
# `npm run check:env` vérifie que le nécessaire est présent.
# =============================================================

# --- Base de données (requis) ---
# 1. Obtenez votre URL PostgreSQL sur Neon.tech.
# 2. Remplacez la valeur ci-dessous par votre propre URL.
DATABASE_URL="postgresql://utilisateur:mot_de_passe@ep-xxx-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification (requis) ---
# En local, gardez une URL locale. En production, utilisez le domaine public.
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="votre_secret_genere_avec_openssl"
AUTH_TRUST_HOST="true"

# --- URLs publiques ---
# Utilisées pour les liens dans les emails, les callbacks de paiement,
# les QR codes des PDF et les métadonnées du site.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
PLA_PUBLIC_SITE_URL="https://primelangageacademy.com"
PLA_PDF_QR_URL="https://primelangageacademy.com"

# --- Email (requis en production) ---
EMAIL_USER="votre_email@gmail.com"
EMAIL_APP_PASSWORD="votre_mot_de_passe_application_gmail"
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@primelangageacademy.com"
EMAIL_FROM_NAME="Prime Language Academy"
ADMIN_EMAIL="admin@primelangageacademy.com"

# --- Notifications ---
N8N_PLA_NOTIFICATIONS_WEBHOOK="https://votre-n8n/webhook/pla-notifications"

# --- Paiement (Paystack / Mobile Money) ---
PAYSTACK_SECRET_KEY="sk_test_xxx"
# Jeton facultatif permettant d'accéder au plan de test de paiement.
PAYSTACK_TEST_PLAN_TOKEN=""

# --- Clés de service ---
# 24 caractères minimum chacune.
ADMIN_BOT_KEY="une_cle_longue_et_aleatoire"
CRON_SECRET="une_autre_cle_longue_et_aleatoire"

# --- Stockage des fichiers (requis en production) ---
# Sans ce jeton, les uploads retombent sur `public/uploads`, éphémère sur Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- IA (notation du test de placement) ---
# Absente => notation heuristique de repli, aucune erreur bloquante.
GEMINI_API_KEY=""

# --- Scripts d'administration (jamais commités avec de vraies valeurs) ---
# Utilisés uniquement par `node scripts/create-admins.mjs`.
# ADMIN_NAME="Administrateur PLA"
# ADMIN_PASSWORD=""
